<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Список постів</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f4f9; }
    nav { margin-bottom: 20px; }
    nav a { margin-right: 15px; text-decoration: none; color: #007bff; font-weight: bold; }
    .post-card { background: white; padding: 15px; margin-bottom: 10px; border-left: 4px solid #007bff; border-radius: 4px; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Головна</a>
    <a href="/posts">Усі пости</a>
    <a href="/add-post">Додати пост</a>
  </nav>
  <h1>Список постів</h1>
  <% if (posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <div class="post-card">
        <h3><%= post.title %></h3>
        <p><strong>Автор:</strong> <%= post.author %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>Постів поки немає. <a href="/add-post">Створіть перший!</a></p>
  <% } %>
</body>
</html>