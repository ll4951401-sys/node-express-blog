<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Блог проект</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f4f9; }
    h1, h2 { color: #333; }
    form { margin-bottom: 30px; background: #fff; padding: 20px; border-radius: 8px; max-width: 400px; }
    input { width: 100%; padding: 8px; margin: 8px 0 16px 0; box-sizing: border-box; }
    button { background-color: #28a745; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; }
    .post-card { background: white; padding: 15px; margin-bottom: 10px; border-radius: 6px; border-left: 4px solid #007bff; }
  </style>
</head>
<body>

  <h1>Створити новий пост</h1>
  <form action="/posts" method="POST">
    <label>Заголовок (Title):</label>
    <input type="text" name="title" required>
    
    <label>Автор (Author):</label>
    <input type="text" name="author" required>
    
    <button type="submit">Додати пост</button>
  </form>

  <h2>Список постів</h2>
  <% if (posts && posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <div class="post-card">
        <h3><%= post.title %></h3>
        <p><strong>Автор:</strong> <%= post.author %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>Постів поки немає.</p>
  <% } %>

</body>
</html>